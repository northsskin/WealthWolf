{
  "id": "business-cash",
  "section": "earning",
  "order": 10,
  "title": "Business Cash Flow & Pricing",
  "description": "Price for profit, read a P&L, and keep cash coming in.",
  "wolfLine": "Profit is the kill. Cash is what you can eat today.",
  "terms": {
    "markup": {
      "term": "Markup",
      "definition": "Your profit on an item, as a percent of what it cost you.",
      "example": "Cost $6, price $15: $9 profit is a 150% markup."
    },
    "profit-margin": {
      "term": "Profit margin",
      "definition": "Your profit on an item, as a percent of its price.",
      "example": "Price $15, profit $9: a 60% margin."
    },
    "break-even-point": {
      "term": "Break-even point",
      "definition": "How many sales it takes to cover all your costs. Below it you lose money, above it you profit.",
      "example": "Costs of $600 a month, $15 left per sale: break even at 40 sales."
    },
    "profit-and-loss": {
      "term": "Profit and loss statement",
      "definition": "A report of a period’s revenue, costs and profit. Often called a P&L.",
      "example": "March: $3,750 revenue, $1,821.50 costs, $1,928.50 profit."
    },
    "owners-draw": {
      "term": "Owner’s draw",
      "definition": "Moving profit from your business account to your personal account to pay yourself.",
      "example": "Transferring $1,200 to yourself on the 1st of each month."
    }
  },
  "lessons": [
    {
      "id": "bc-pricing",
      "type": "lesson",
      "title": "Price to Cover Your Costs",
      "summary": "Every price has to beat your costs and survive your customers.",
      "xp": 10,
      "steps": [
        {
          "id": "bc-pricing-q1",
          "type": "info",
          "title": "Three numbers behind every price",
          "body": "What each item costs you to make, what the business costs to run each month, and what customers will pay. Your price has to beat the first two, and survive the third."
        },
        {
          "id": "bc-pricing-q2",
          "type": "number",
          "prompt": "A candle costs you $6 to make. You sell it for $15. How much is left per candle?",
          "answer": 9,
          "unit": "$",
          "explain": "$15 − $6 = $9."
        },
        {
          "id": "bc-pricing-q3",
          "type": "number",
          "prompt": "Your booth costs $120 a month. How many candles must you sell just to cover it? Round up to a whole candle.",
          "answer": 14,
          "unit": "candles",
          "explain": "$120 ÷ $9 = 13.3, so 14 candles."
        },
        {
          "id": "bc-pricing-q4",
          "type": "multiple_choice",
          "prompt": "A competitor sells similar candles for $12. What do you do?",
          "choices": [
            "Show why yours are worth $15, or find ways to cut costs",
            "Sell at $5 to win",
            "Ignore them"
          ],
          "answer": 0,
          "explain": "Racing to the bottom rarely ends well."
        },
        {
          "id": "bc-pricing-q5",
          "type": "true_false",
          "prompt": "Pricing too low can make a busy business lose money.",
          "answer": true,
          "explain": "More sales at a loss is more loss."
        },
        {
          "id": "bc-pricing-q6",
          "type": "multiple_choice",
          "prompt": "Which costs belong in your price?",
          "choices": [
            "Materials, your time, fees and overhead",
            "Only materials",
            "None"
          ],
          "answer": 0,
          "explain": "If it costs you, the price must cover it."
        }
      ]
    },
    {
      "id": "bc-markup-margin",
      "type": "lesson",
      "title": "Markup and Margin",
      "summary": "Two ways to measure the same profit.",
      "xp": 10,
      "steps": [
        {
          "id": "bc-markup-margin-q1",
          "type": "number",
          "context": "[[Markup]] compares your profit to your cost. [[Profit margin]] compares your profit to the price.",
          "prompt": "Cost $6, price $15, profit $9. What’s the markup?",
          "answer": 150,
          "unit": "%",
          "explain": "$9 ÷ $6 = 1.5, which is 150%."
        },
        {
          "id": "bc-markup-margin-q2",
          "type": "number",
          "prompt": "And the profit margin?",
          "answer": 60,
          "unit": "%",
          "explain": "$9 ÷ $15 = 0.6, which is 60%."
        },
        {
          "id": "bc-markup-margin-q3",
          "type": "multiple_choice",
          "prompt": "Which is always the smaller percent?",
          "choices": [
            "Margin",
            "Markup"
          ],
          "answer": 0,
          "explain": "Margin divides by the bigger number, the price."
        },
        {
          "id": "bc-markup-margin-q4",
          "type": "number",
          "prompt": "You want a 50% margin on something that costs you $10. What price? (Price = cost ÷ 0.5)",
          "answer": 20,
          "unit": "$",
          "explain": "$10 ÷ 0.5 = $20."
        },
        {
          "id": "bc-markup-margin-q5",
          "type": "true_false",
          "prompt": "A 100% markup means you charge double your cost.",
          "answer": true,
          "explain": "Cost $10, profit $10, price $20."
        },
        {
          "id": "bc-markup-margin-q6",
          "type": "number",
          "prompt": "Cost $8, price $10. What’s the profit margin?",
          "answer": 20,
          "unit": "%",
          "explain": "$2 ÷ $10 = 0.2, which is 20%."
        }
      ]
    },
    {
      "id": "bc-break-even",
      "type": "lesson",
      "title": "The Break-Even Point",
      "summary": "How many sales before you make a dime.",
      "xp": 10,
      "steps": [
        {
          "id": "bc-break-even-q1",
          "type": "multiple_choice",
          "context": "Your [[break-even point]] is how many sales it takes to cover all your costs. Below it you lose money, above it you profit.",
          "prompt": "What happens at the break-even point?",
          "choices": [
            "Revenue equals costs: no profit, no loss",
            "Profit is highest",
            "You go broke"
          ],
          "answer": 0,
          "explain": "Every sale after it is profit."
        },
        {
          "id": "bc-break-even-q2",
          "type": "number",
          "prompt": "Monthly costs are $600. Each sale leaves $15 after its own costs. How many sales to break even?",
          "answer": 40,
          "unit": "sales",
          "explain": "$600 ÷ $15 = 40."
        },
        {
          "id": "bc-break-even-q3",
          "type": "number",
          "prompt": "You make 55 sales. What’s the profit?",
          "answer": 225,
          "unit": "$",
          "explain": "15 sales past break-even × $15 = $225."
        },
        {
          "id": "bc-break-even-q4",
          "type": "number",
          "prompt": "Raise the price so each sale leaves $20. What’s the new break-even?",
          "answer": 30,
          "unit": "sales",
          "explain": "$600 ÷ $20 = 30."
        },
        {
          "id": "bc-break-even-q5",
          "type": "true_false",
          "prompt": "Lowering your monthly costs lowers your break-even point.",
          "answer": true,
          "explain": "Less to cover, fewer sales needed."
        },
        {
          "id": "bc-break-even-q6",
          "type": "multiple_choice",
          "prompt": "You sell 25 a month and break-even is 40. Your options?",
          "choices": [
            "Raise prices, cut costs, or sell more",
            "Ignore it",
            "Hire more people"
          ],
          "answer": 0,
          "explain": "Three levers. Pull at least one."
        }
      ]
    },
    {
      "id": "bc-cash-timing",
      "type": "lesson",
      "title": "Profit Isn’t Cash",
      "summary": "Why profitable businesses still run out of money.",
      "xp": 10,
      "steps": [
        {
          "id": "bc-cash-timing-q1",
          "type": "info",
          "title": "Profitable and broke",
          "body": "A business can be profitable on paper and still run out of cash, because money goes out before it comes in. You pay for supplies today, and customers may pay you in 30 or 60 days."
        },
        {
          "id": "bc-cash-timing-q2",
          "type": "number",
          "prompt": "You buy $2,000 of supplies on May 1. The client pays $3,500 on June 15. What’s the profit on the job?",
          "answer": 1500,
          "unit": "$",
          "explain": "$3,500 − $2,000 = $1,500."
        },
        {
          "id": "bc-cash-timing-q3",
          "type": "multiple_choice",
          "prompt": "On May 31, how does your cash look?",
          "choices": [
            "Down $2,000, waiting on payment",
            "Up $1,500",
            "Even"
          ],
          "answer": 0,
          "explain": "The profit exists, but not in your account yet."
        },
        {
          "id": "bc-cash-timing-q4",
          "type": "multiple_choice",
          "prompt": "How can you close the gap?",
          "choices": [
            "Deposits upfront, faster invoicing, or a cash cushion",
            "Ignore it",
            "Pay suppliers late on purpose"
          ],
          "answer": 0,
          "explain": "Get money in sooner, or keep more on hand."
        },
        {
          "id": "bc-cash-timing-q5",
          "type": "true_false",
          "prompt": "Cash flow problems sink many profitable small businesses.",
          "answer": true,
          "explain": "Running out of cash ends a business faster than low profit."
        },
        {
          "id": "bc-cash-timing-q6",
          "type": "multiple_choice",
          "prompt": "Which habit speeds up cash coming in?",
          "choices": [
            "Invoicing the day the work is done",
            "Waiting a month to invoice",
            "Offering 90-day terms"
          ],
          "answer": 0,
          "explain": "The clock on net 30 only starts when you invoice."
        }
      ]
    },
