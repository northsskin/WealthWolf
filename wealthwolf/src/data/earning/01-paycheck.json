{
  "id": "paycheck",
  "section": "earning",
  "order": 1,
  "title": "Your Paycheck",
  "description": "Hourly, salary, overtime, and every line on your pay stub.",
  "wolfLine": "Read the stub. Every line is either yours or someone’s excuse.",
  "terms": {
    "hourly-wage": {
      "term": "Hourly wage",
      "definition": "Pay for every hour you work. More hours, more pay.",
      "example": "$18 an hour × 40 hours = $720 for the week."
    },
    "salary": {
      "term": "Salary",
      "definition": "A fixed yearly amount, split across your paychecks, no matter how many hours you work.",
      "example": "$52,000 a year, paid as 26 paychecks of $2,000."
    },
    "minimum-wage": {
      "term": "Minimum wage",
      "definition": "The lowest hourly pay allowed by law. The federal minimum is $7.25, and many states and cities set a higher one.",
      "example": "A state minimum of $15 an hour beats the federal $7.25."
    },
    "overtime": {
      "term": "Overtime",
      "definition": "Extra pay for hours past 40 in a workweek. Under federal law most hourly workers get 1.5 times their usual rate.",
      "example": "At $20 an hour, overtime pays $30 an hour."
    },
    "fica": {
      "term": "FICA",
      "definition": "The two payroll taxes on every paycheck: Social Security (6.2%) and Medicare (1.45%).",
      "example": "7.65% of $1,680 is $128.52 of FICA."
    },
    "pre-tax-deduction": {
      "term": "Pre-tax deduction",
      "definition": "Money taken from your pay before income tax is worked out, so you’re taxed on less.",
      "example": "A traditional 401(k) contribution or a work health insurance premium."
    },
    "year-to-date": {
      "term": "Year-to-date",
      "definition": "Totals since January 1 of this year, often shown as YTD on a pay stub.",
      "example": "YTD gross pay through June: $21,840."
    },
    "w-2": {
      "term": "W-2",
      "definition": "The yearly summary of your pay and the taxes taken out, sent by your employer each January, used to file your taxes.",
      "example": "Your W-2 shows $43,680 of wages and the federal tax withheld from them."
    }
  },
  "lessons": [
    {
      "id": "pc-hourly-salary",
      "type": "lesson",
      "title": "Hourly vs. Salary",
      "summary": "Two ways to get paid, and how to compare them.",
      "xp": 10,
      "steps": [
        {
          "id": "pc-hourly-salary-q1",
          "type": "multiple_choice",
          "context": "An [[hourly wage]] pays you for every hour you work. A [[salary]] is a fixed yearly amount, split across your paychecks, no matter how many hours you put in.",
          "prompt": "Which kind of pay changes when you work more hours?",
          "choices": [
            "Hourly",
            "Salary"
          ],
          "answer": 0,
          "explain": "Hourly pay counts every hour. A salary stays the same."
        },
        {
          "id": "pc-hourly-salary-q2",
          "type": "number",
          "prompt": "You earn $18 an hour and work 40 hours a week. What’s your weekly pay before deductions?",
          "answer": 720,
          "unit": "$",
          "explain": "$18 × 40 = $720."
        },
        {
          "id": "pc-hourly-salary-q3",
          "type": "number",
          "context": "To turn hourly pay into a yearly number, multiply by hours a week, then by 52 weeks.",
          "prompt": "$18 an hour, 40 hours a week, 52 weeks. What’s that for a year?",
          "answer": 37440,
          "unit": "$",
          "explain": "$18 × 40 × 52 = $37,440."
        },
        {
          "id": "pc-hourly-salary-q4",
          "type": "number",
          "prompt": "A salary of $52,000. What’s that per hour at 40 hours a week? Divide by 2,080 hours.",
          "answer": 25,
          "unit": "$",
          "explain": "$52,000 ÷ 2,080 = $25 an hour."
        },
        {
          "id": "pc-hourly-salary-q5",
          "type": "multiple_choice",
          "prompt": "You’re salaried at $52,000 and work 50 hours one week. What usually happens to your pay?",
          "choices": [
            "Nothing: a salary stays the same",
            "It goes up 25%",
            "It goes down"
          ],
          "answer": 0,
          "explain": "Many salaried jobs don’t pay for extra hours. The next lesson explains why."
        },
        {
          "id": "pc-hourly-salary-q6",
          "type": "true_false",
          "context": "The federal [[minimum wage]] is $7.25 an hour, and many states and cities set a higher one.",
          "prompt": "Your state can require a higher minimum wage than the federal $7.25.",
          "answer": true,
          "explain": "Many states and cities do. The higher one wins."
        },
        {
          "id": "pc-hourly-salary-q7",
          "type": "multiple_choice",
          "prompt": "What’s a perk of hourly pay?",
          "choices": [
            "Every extra hour you work gets paid",
            "Your pay never changes",
            "No taxes"
          ],
          "answer": 0,
          "explain": "Extra shifts mean extra money."
        }
      ]
    },
