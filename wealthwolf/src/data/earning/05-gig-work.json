    {
      "id": "gw-real-pay",
      "type": "lesson",
      "title": "Your Real Hourly Pay",
      "summary": "What the app shows isn’t what you earn.",
      "xp": 10,
      "steps": [
        {
          "id": "gw-real-pay-q1",
          "type": "number",
          "context": "Apps show what you earned per job. Your real hourly pay is earnings minus costs, divided by every hour you were working, including waiting.",
          "prompt": "You earned $160 in 8 hours of driving. What’s that per hour, before costs?",
          "answer": 20,
          "unit": "$",
          "explain": "$160 ÷ 8 = $20."
        },
        {
          "id": "gw-real-pay-q2",
          "type": "number",
          "prompt": "Gas and wear on your car cost $48. What’s left?",
          "answer": 112,
          "unit": "$",
          "explain": "$160 − $48 = $112."
        },
        {
          "id": "gw-real-pay-q3",
          "type": "number",
          "prompt": "So what’s your real pay per hour over those 8 hours?",
          "answer": 14,
          "unit": "$",
          "explain": "$112 ÷ 8 = $14."
        },
        {
          "id": "gw-real-pay-q4",
          "type": "number",
          "prompt": "You also spent 2 unpaid hours waiting for orders. What’s your real pay per hour over all 10 hours?",
          "answer": 11.2,
          "unit": "$",
          "tolerance": 0.005,
          "explain": "$112 ÷ 10 = $11.20."
        },
        {
          "id": "gw-real-pay-q5",
          "type": "multiple_choice",
          "prompt": "What matters most when choosing a gig?",
          "choices": [
            "Pay per hour after costs",
            "Pay per order",
            "How fun the app looks"
          ],
          "answer": 0,
          "explain": "The number that pays your rent."
        },
        {
          "id": "gw-real-pay-q6",
          "type": "true_false",
          "prompt": "Earning $25 per order always beats $18 an hour.",
          "answer": false,
          "explain": "Not if each order takes two hours of driving."
        }
      ]
    },
