{
  "id": "gig-work",
  "section": "earning",
  "order": 5,
  "title": "Gig Work & Side Hustles",
  "description": "App gigs and side hustles: what they really pay after costs and taxes.",
  "wolfLine": "Count every hour, including the ones you spend waiting.",
  "terms": {
    "gig-work": {
      "term": "Gig work",
      "definition": "Short jobs, one at a time, often through an app: delivery, rideshare, task apps.",
      "example": "Delivering food through an app on weekends."
    },
    "independent-contractor": {
      "term": "Independent contractor",
      "definition": "Someone paid for work as their own small business, not as an employee. No employer benefits, and no taxes taken out.",
      "example": "A rideshare driver who sets their own hours and pays for their own gas."
    },
    "form-1099": {
      "term": "Form 1099",
      "definition": "A tax form showing what a business paid you as a contractor. Nothing was taken out for taxes.",
      "example": "A delivery app sends you a 1099 showing $9,400 paid last year."
    },
    "side-hustle": {
      "term": "Side hustle",
      "definition": "Paid work you do alongside your main job.",
      "example": "Tutoring math two evenings a week."
    }
  },
