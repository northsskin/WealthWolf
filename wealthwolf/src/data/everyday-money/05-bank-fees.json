{
  "id": "bank-fees",
  "section": "everyday-money",
  "order": 5,
  "title": "Bank Fees & Statements",
  "description": "Read a statement, dodge the fees, and catch the bank’s mistakes.",
  "wolfLine": "Fees are small bites. Enough small bites and you’re dinner.",
  "terms": {
    "bank-statement": {
      "term": "Bank statement",
      "definition": "The monthly record of your account: the starting balance, every transaction, and the ending balance.",
      "example": "September’s statement: opened at $640.00, closed at $1,609.12."
    },
    "maintenance-fee": {
      "term": "Maintenance fee",
      "definition": "A monthly charge just for having the account, often waived if you meet a condition like a minimum balance.",
      "example": "$12 a month unless you keep $1,500 in the account."
    },
    "overdraft": {
      "term": "Overdraft",
      "definition": "Spending more than you have in your account, when the bank lets the payment go through anyway.",
      "example": "Buying a $26 lunch with $20 in the account."
    },
    "overdraft-fee": {
      "term": "Overdraft fee",
      "definition": "What a bank charges each time a payment overdraws your account, often about $35.",
      "example": "A $6 overdraft plus a $35 fee: that lunch really cost $41 more than you had."
    },
    "overdraft-protection": {
      "term": "Overdraft protection",
      "definition": "A setting that covers a shortfall by moving money from your savings, instead of charging an overdraft fee.",
      "example": "You’re $6 short, so $6 moves over from savings automatically."
    },
    "dispute": {
      "term": "Dispute",
      "definition": "Asking your bank to investigate a charge you think is wrong and reverse it.",
      "example": "Reporting a $64 charge from a store you’ve never shopped at."
    },
    "reconcile": {
      "term": "Reconcile",
      "definition": "Checking your own record of spending against the bank’s, line by line, until they match.",
      "example": "Your notes say $450 left, the bank says $415. Reconciling finds the missing $35."
    }
  },
