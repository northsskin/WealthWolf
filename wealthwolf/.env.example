# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These values identify the project; they are not secrets. Access is guarded by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local testing without a Firebase project: `npm run dev:emu` runs the Auth emulator
# (accounts live only on this machine) and loads .env.emu instead of this file.
# Emulator test account used for automated checks: wolf.tester@example.test / ledger-pup-2026
